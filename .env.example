# Optional. Leave both keys empty to run with offline (rule-based) agents.
# If both are set, Gemini is used unless AI_PROVIDER=claude.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# AI_PROVIDER=gemini
# GEMINI_MODEL=gemini-3.8-flash
# ANTHROPIC_MODEL=claude-opus-5
# PORT=3000
# Your company's name. Invoices it SENT (where it is the "From:" vendor) are income,
# so the invoice automation does not add them to expenses.csv. Case and suffixes like
# "(Pvt.) Ltd." are ignored. Defaults to Brightleaf Labs, the studio in the sample files.
# OWN_COMPANY=Brightleaf Labs
